# Optional AI API Key (Gemini / OpenAI for live custom model calls)
VITE_AI_API_KEY=

# Optional Google Maps API Key (Leaflet / SVG interactive canvas runs by default)
VITE_GOOGLE_MAPS_API_KEY=
